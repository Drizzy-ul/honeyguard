# HoneyGuard Configuration

# Server Ports
HONEYPOT_SSH_PORT=2222
HONEYPOT_HTTP_PORT=8080
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0

# Decoy Banners & Signatures
SSH_BANNER=SSH-2.0-OpenSSH_8.2p1 Ubuntu-4ubuntu0.5
HTTP_SERVER_BANNER=Apache/2.4.41 (Ubuntu)

# Interactive SSH Decoy Shell (accept credentials and capture commands)
SSH_ALLOW_INTERACTIVE=true

# Webhook Alerting (Optional - set to your Discord/Slack webhook URLs)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Alert Rate Limiting (seconds between alerts per attacker IP to prevent flooding)
ALERT_COOLDOWN_SECONDS=30

# MaxMind GeoIP DB Path (optional; free IP API is used as fallback)
GEOIP_DB_PATH=
